#importing pygame, random and sys
import pygame as pu
import random
import sys 

#initalize pygame
pu.init()

#set up screen
WIDTH = 700
HEIGHT = 700
screen = pu.display.set_mode((WIDTH,HEIGHT))
pu.display.set_caption("spaceshooter")

#colors
WHI=(255,255,255)
RED = (245,56,49)

#CLOCK
clock = pu.time.Clock()
FPS = 60

#loadspaceship
player_img = pu.Surface((50,40))
player_img.fill (WHI)
player_x = WIDTH // 2 - 25
player_y = HEIGHT - 60
player_speed = 5

#Bullet
bullet_img = pu.Surface((5,10))
bullet_img.fill(RED)
bullets = []
bullet_speed = 7


#enemy
enemy_img = pu.Surface((40,30))
enemy_img.fill((0,255,0))
enemies = []
enemy_speed = 3
enemy_spawn_delay = 30#frames
enemy_timer = 0

#score 
score = 0
font = pu.font.SysFont(None,30)

#function to draw text
def draw_text(text,x,y):
    img=font.render(text,True,WHI)
    screen.blit(img,(x,y))

    #mainloop
running = True
while running:
    clock.tick(FPS)
    screen.fill((105,56,166))#background

    #events
    for event in pu.event.get():
        if event.type == pu.QUIT:
            running=False

        #keypresses
    keys = pu.key.get_pressed()
    if keys[pu.K_LEFT]and player_x > 0:
        player_x -= player_speed
    if keys[pu.K_RIGHT]and player_x < WIDTH - 50:
        player_x += player_speed
    if keys[pu.K_SPACE]:
        if len(bullets)<5:#limit number of bullets
            bullets.append([player_x + 22,player_y])

            #update bullets. bullet mean 1 bullets
    for bullet in bullets[:]:
        bullet[1] -= bullet_speed
        # if the bullets lengh is less than 0 then remove it
        if bullet[1] < 0:
            bullets.remove(bullet)
#spawn enemies
    enemy_timer += 1
    if enemy_timer > enemy_spawn_delay:
        enemy_x = random.randint(0, WIDTH - 40)
        enemies.append([enemy_x,0])
        enemy_timer = 10

        #update enemies enemy means 1 enemy while enemies is the mainloop
        for enemy in enemies[:]:
            enemy[1]+=enemy_speed 
            if enemy[1] > HEIGHT:
                enemies.remove(enemy)

                #collision detection
        for bullet in bullets[:]:
           for enemy in enemies[:]:
            #when the bullet touch the enemy the enemy and the bullet disappear
                if(bullet[0] in range(enemy[0],enemy[0] + 40) and bullet[1] in range(enemy[1], enemy[1]+30)):
                    bullets.remove(bullet)
                    enemies.remove(enemy)
                    score += 1 
                    break

    #draw player
    screen.blit(player_img, (player_x, player_y))

    #Draw bullet/createing bullet
    for bullet in bullets:
        screen.blit(bullet_img, (bullet[0], bullet[1]))

    #draw enemy/createing enemy
    for enemy in enemies:
                screen.blit(enemy_img, (enemy[0], enemy[1]))

        #draw score/putting the score on screen
    draw_text(f"Score: {score}", 10,10)

    pu.display.update()

    #The end
pu.quit()
sys.exit()
